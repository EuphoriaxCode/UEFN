   }
  },
  {
   "description": "Find Verse entities in the current editor scene, optionally scoped and filtered.",
   "name": "ValkyrieToolset.EntityToolset.FindEntities",
   "inputSchema": {
    "type": "object",
    "properties": {
     "rootEntity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "An entity to list under; omit to list from the root of every loaded level.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ],
      "default": null
     },
     "bRecursive": {
      "type": "boolean",
      "description": "Whole subtree when true; immediate children when false.",
      "default": true
     },
     "nameFilter": {
      "type": "string",
      "description": "Case-insensitive substring matched against each entity's friendly name; empty matches all.",
      "default": ""
     }
    }
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "type": "array",
      "items": {
       "title": "EntityInfo",
       "type": "object",
       "properties": {
        "entity": {
         "type": "object",
         "title": "/Script/Entity.BaseEntity",
         "description": "The entity.",
         "properties": {
          "refPath": {
           "type": "string",
           "description": "The reference stored as a soft path string."
          }
         },
         "required": [
          "refPath"
         ]
        },
        "displayName": {
         "type": "string",
         "description": "Friendly Verse name (the outliner label); keeps a uniquifying _<id> suffix."
        },
        "entityClass": {
         "type": "object",
         "title": "Class@/Script/Entity.BaseEntity",
         "description": "The entity's class.",
         "properties": {
          "refPath": {
           "type": "string",
           "description": "The reference stored as a soft path string."
          }
         },
         "required": [
          "refPath"
         ]
        }
       },
       "required": [
        "entity",
        "displayName",
        "entityClass"
       ]
      },
      "description": "One entry per matching entity."
     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
  {
   "description": "Delete a Verse entity from the current editor scene. Also destroys its child entities and components.",
   "name": "ValkyrieToolset.EntityToolset.DeleteEntity",
   "inputSchema": {
    "type": "object",
    "properties": {
     "entity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "The target entity. The level root cannot be deleted.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     }
    },
    "required": [
     "entity"
    ]
   }
  },
  {
