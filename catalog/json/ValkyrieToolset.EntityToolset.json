     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
  {
   "description": "Read a component's editable property value, by its friendly Verse name.",
   "name": "ValkyrieToolset.EntityToolset.GetComponentProperty",
   "inputSchema": {
    "type": "object",
    "properties": {
     "component": {
      "type": "object",
      "title": "/Script/Entity.BaseComponent",
      "description": "The target component.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     },
     "propertyName": {
      "type": "string",
