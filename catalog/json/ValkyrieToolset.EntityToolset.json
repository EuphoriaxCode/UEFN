    ]
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "type": "array",
      "items": {
       "title": "EntityComponentInfo",
       "type": "object",
       "properties": {
        "component": {
         "type": "object",
         "title": "/Script/Entity.BaseComponent",
         "description": "The component.",
         "properties": {
          "refPath": {
           "type": "string",
