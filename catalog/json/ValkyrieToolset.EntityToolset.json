   "name": "ValkyrieToolset.EntityToolset.CreateEntity",
   "inputSchema": {
    "type": "object",
    "properties": {
     "entityClass": {
      "type": "object",
      "title": "Class@/Script/Entity.BaseEntity",
      "description": "The entity class to instantiate (a verse::entity subclass).",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     },
     "transform": {
      "type": "object",
      "title": "ToolsetTransform",
      "description": "World transform for the new entity (a transform component is added for it).",
      "properties": {
       "location": {
        "description": "The world-space location.",
        "title": "Vector",
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         },
         "z": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y",
         "z"
        ]
       },
       "rotation": {
        "description": "The world-space rotation.",
        "title": "Rotator",
        "type": "object",
        "properties": {
         "pitch": {
          "type": "number",
          "description": "Pitch (degrees) around Y axis"
         },
         "yaw": {
          "type": "number",
          "description": "Yaw (degrees) around Z axis"
         },
         "roll": {
          "type": "number",
          "description": "Roll (degrees) around X axis"
         }
        },
        "required": [
         "pitch",
         "yaw",
         "roll"
        ]
       },
       "scale": {
        "description": "The scale.",
        "title": "Vector",
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         },
         "z": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y",
         "z"
        ]
       }
      }
     },
     "name": {
      "type": "string",
      "description": "Desired entity name; empty auto-generates one.",
      "default": ""
     },
     "parentEntity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "The entity to create under; omit to create at the persistent level's root.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ],
      "default": null
     }
    },
    "required": [
     "entityClass",
     "transform"
    ]
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "title": "EntityInfo",
      "description": "The created entity.",
      "type": "object",
      "properties": {
       "entity": {
        "type": "object",
        "title": "/Script/Entity.BaseEntity",
        "description": "The entity.",
        "properties": {
         "refPath": {
          "type": "string",
          "description": "The reference stored as a soft path string."
         }
        },
        "required": [
         "refPath"
        ]
       },
       "displayName": {
        "type": "string",
        "description": "Friendly Verse name (the outliner label); keeps a uniquifying _<id> suffix."
       },
       "entityClass": {
        "type": "object",
        "title": "Class@/Script/Entity.BaseEntity",
        "description": "The entity's class.",
        "properties": {
         "refPath": {
          "type": "string",
          "description": "The reference stored as a soft path string."
         }
        },
        "required": [
         "refPath"
        ]
       }
      },
      "required": [
       "entity",
       "displayName",
       "entityClass"
      ]
     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
