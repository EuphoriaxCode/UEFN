{
 "name": "ValkyrieToolset.EntityToolset",
 "version": "1.0",
 "description": "Inspects, navigates, and edits the Verse Scene Graph (verse::entity / verse::component\nhierarchies) in the current editor level: listing entities and their components and the\nclasses available to instantiate, creating and deleting entities, attaching and removing\ncomponents, reading and writing component properties by their friendly Verse name, and\ngetting/setting an entity's world transform.",
 "tools": [
  {
   "description": "Set a Verse entity's world transform (adds a transform component if it has none).",
   "name": "ValkyrieToolset.EntityToolset.SetEntityTransform",
   "inputSchema": {
    "type": "object",
    "properties": {
     "entity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "The target entity.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     },
     "transform": {
      "type": "object",
      "title": "ToolsetTransform",
      "description": "The new world-space transform.",
      "properties": {
       "location": {
        "description": "The world-space location.",
        "title": "Vector",
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         },
         "z": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y",
         "z"
        ]
       },
       "rotation": {
        "description": "The world-space rotation.",
        "title": "Rotator",
        "type": "object",
        "properties": {
         "pitch": {
          "type": "number",
          "description": "Pitch (degrees) around Y axis"
         },
         "yaw": {
          "type": "number",
          "description": "Yaw (degrees) around Z axis"
         },
         "roll": {
          "type": "number",
          "description": "Roll (degrees) around X axis"
         }
        },
        "required": [
         "pitch",
         "yaw",
         "roll"
        ]
       },
       "scale": {
        "description": "The scale.",
        "title": "Vector",
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         },
         "z": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y",
         "z"
        ]
       }
      }
     }
    },
    "required": [
     "entity",
     "transform"
    ]
   }
  },
  {
   "description": "Write one property on a component, by its friendly Verse name.",
   "name": "ValkyrieToolset.EntityToolset.SetComponentProperty",
   "inputSchema": {
    "type": "object",
    "properties": {
     "component": {
      "type": "object",
      "title": "/Script/Entity.BaseComponent",
      "description": "The target component.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     },
     "propertyName": {
      "type": "string",
      "description": "The property's friendly Verse name."
     },
     "value": {
      "type": "string",
      "description": "The new value, JSON-encoded \u2014 e.g. 5, true, \"text\", {\"X\":1,\"Y\":2,\"Z\":3}."
     }
    },
    "required": [
     "component",
     "propertyName",
     "value"
    ]
   }
  },
  {
   "description": "Remove a component from a Verse entity.",
   "name": "ValkyrieToolset.EntityToolset.RemoveComponent",
   "inputSchema": {
    "type": "object",
    "properties": {
     "entity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "The target entity.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     },
     "componentClass": {
      "type": "object",
      "title": "Class@/Script/Entity.BaseComponent",
      "description": "The component class to remove (a verse::component subclass).",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     }
    },
    "required": [
     "entity",
     "componentClass"
    ]
   }
  },
  {
   "description": "List the concrete Verse entity classes that can be instantiated (verse::entity subclasses),\noptionally filtered. Covers loaded classes (including a just-built, unsaved Verse class) and\nunloaded prefab classes.",
   "name": "ValkyrieToolset.EntityToolset.ListEntityClasses",
   "inputSchema": {
    "type": "object",
    "properties": {
     "nameFilter": {
      "type": "string",
      "description": "Case-insensitive substring matched against each class's friendly name; empty matches all.",
      "default": ""
     }
    }
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "type": "array",
      "items": {
       "title": "EntityClassInfo",
       "type": "object",
       "properties": {
        "classPath": {
         "type": "object",
         "title": "Class@/Script/CoreUObject.Object",
         "description": "The class path.",
         "properties": {
          "refPath": {
           "type": "string",
           "description": "The reference stored as a soft path string."
          }
         },
         "required": [
          "refPath"
         ]
        },
        "className": {
         "type": "string",
         "description": "Friendly name (a prefab _C suffix is stripped)."
        },
        "bIsPrefab": {
         "type": "boolean",
         "description": "True for a prefab class (a generated _C class); false for a plain native/Verse class."
        }
       },
       "required": [
        "classPath",
        "className",
        "bIsPrefab"
       ]
      },
      "description": "One entry per matching class."
     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
  {
   "description": "List a Verse component's editable properties.",
   "name": "ValkyrieToolset.EntityToolset.ListComponentProperties",
   "inputSchema": {
    "type": "object",
    "properties": {
     "component": {
      "type": "object",
      "title": "/Script/Entity.BaseComponent",
      "description": "The target component.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
       }
      },
      "required": [
       "refPath"
      ]
     }
    },
    "required": [
     "component"
    ]
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "type": "array",
      "items": {
       "title": "EntityPropertyInfo",
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "description": "Friendly Verse name."
        },
        "type": {
         "type": "string",
         "description": "C++ type, e.g. bool, double, FLinearColor."
        },
        "value": {
         "type": "string",
         "description": "Current value as JSON \u2014 the shape a property write accepts."
        },
        "bReadOnly": {
         "type": "boolean",
         "description": "True when the property can't be written."
        }
       },
       "required": [
        "name",
        "type",
        "value",
        "bReadOnly"
       ]
      },
      "description": "One entry per editable property; a transform component's properties are read-only (the entity's transform is edited on the entity, not the component)."
     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
  {
   "description": "List the concrete Verse component classes that can be attached (verse::component subclasses),\noptionally filtered. Covers loaded classes (including a just-built, unsaved Verse class) and\nunloaded prefab classes.",
   "name": "ValkyrieToolset.EntityToolset.ListComponentClasses",
   "inputSchema": {
    "type": "object",
    "properties": {
     "nameFilter": {
      "type": "string",
      "description": "Case-insensitive substring matched against each class's friendly name; empty matches all.",
      "default": ""
     }
    }
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "returnValue": {
      "type": "array",
      "items": {
       "title": "EntityClassInfo",
       "type": "object",
       "properties": {
        "classPath": {
         "type": "object",
         "title": "Class@/Script/CoreUObject.Object",
         "description": "The class path.",
         "properties": {
          "refPath": {
           "type": "string",
           "description": "The reference stored as a soft path string."
          }
         },
         "required": [
          "refPath"
         ]
        },
        "className": {
         "type": "string",
         "description": "Friendly name (a prefab _C suffix is stripped)."
        },
        "bIsPrefab": {
         "type": "boolean",
         "description": "True for a prefab class (a generated _C class); false for a plain native/Verse class."
        }
       },
       "required": [
        "classPath",
        "className",
        "bIsPrefab"
       ]
      },
      "description": "One entry per matching class."
     }
    },
    "required": [
     "returnValue"
    ]
   }
  },
  {
   "description": "Get a Verse entity's world transform.",
   "name": "ValkyrieToolset.EntityToolset.GetEntityTransform",
   "inputSchema": {
    "type": "object",
    "properties": {
     "entity": {
      "type": "object",
      "title": "/Script/Entity.BaseEntity",
      "description": "The target entity. An entity with no transform component reports its parent's world transform.",
      "properties": {
       "refPath": {
        "type": "string",
        "description": "The reference stored as a soft path string."
